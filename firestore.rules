rules_version = '2';
// Rules for the Library's uploaded files (Settings > Library admin).
// Anyone can read, so students can list and download. Only the admin Google account(s) below can add, change or delete.
// EDIT the email list, then publish with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['andereya8@gmail.com'];
    }

    // One small document lists every uploaded file, so a page view costs one read.
    match /library/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The file bytes, in pieces under the 1 MiB document limit: libraryChunks/<file id>/parts/<0000, 0001, ...>
    match /libraryChunks/{fileId}/parts/{part} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 900000;
      allow delete: if isAdmin();
    }
  }
}
